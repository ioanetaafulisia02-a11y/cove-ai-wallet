# Cove — server-only secrets
# Copy to `.env` locally. Never prefix these with VITE_ (that leaks them to the browser).
# Never commit `.env`.

# xAI Grok API key — used by the chat agent (https://console.x.ai)
XAI_API_KEY=

# Trust Wallet Agent Kit — from https://portal.trustwallet.com
# Access ID (also accepted as AGENT_KIT_ID)
TWAK_ACCESS_ID=
# HMAC secret paired with the access id
TWAK_HMAC_SECRET=
